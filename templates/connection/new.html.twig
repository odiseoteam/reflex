{% extends 'base.html.twig' %}

{% form_theme form 'form/tailwind.html.twig' %}

{% block title %}Connect a server · Reflex{% endblock %}

{% block body %}
    <h1 class="mb-1 text-2xl font-semibold">Connect a server</h1>
    <p class="mb-6 text-sm text-slate-600">Any MCP server over Streamable HTTP. With OAuth you are sent to its authorization server to sign in.</p>

    {# Turbo can't follow the redirect to another origin for OAuth #}
    {{ form_start(form, {attr: {class: 'max-w-xl space-y-5 rounded-lg border border-slate-200 bg-white p-6', 'data-turbo': 'false'}}) }}
        {{ form_row(form.name) }}
        {{ form_row(form.url) }}
        {{ form_row(form.auth) }}

        <fieldset class="space-y-4 rounded-md border border-slate-200 p-4">
            <legend class="px-1 text-sm font-medium text-slate-700">Bearer token</legend>
            {{ form_row(form.token) }}
        </fieldset>

        <fieldset class="space-y-4 rounded-md border border-slate-200 p-4">
            <legend class="px-1 text-sm font-medium text-slate-700">OAuth pre-registered client (optional)</legend>
            {{ form_row(form.oauthClientId) }}
            {{ form_row(form.oauthClientSecret) }}
            {{ form_row(form.oauthIssuer) }}
        </fieldset>

        <div class="flex items-center gap-3">
            <button type="submit" class="rounded-md bg-slate-900 px-4 py-2 text-sm font-medium text-white hover:bg-slate-700">Connect</button>
            <a href="{{ path('app_connection_index') }}" class="text-sm text-slate-600 hover:text-slate-900">Cancel</a>
        </div>
    {{ form_end(form) }}
{% endblock %}
