{% extends 'base.html.twig' %}

{% form_theme form 'form/tailwind.html.twig' %}

{% block title %}Connect a server · Reflex{% endblock %}

{% block body %}
    <twig:PageHeader title="Connect a server" subtitle="Any MCP server over Streamable HTTP. With OAuth you are sent to its authorization server to sign in." :crumbs="[{label: 'Connections', url: path('app_connection_index')}]" />

    {# Turbo can't follow the redirect to another origin for OAuth #}
    {{ form_start(form, {attr: {class: 'grid max-w-2xl gap-6', 'data-turbo': 'false'}}) }}
        <twig:Panel title="Server">
            <div class="grid gap-5">
                {{ form_row(form.name) }}
                {{ form_row(form.url) }}
                {{ form_row(form.auth) }}
            </div>
        </twig:Panel>

        <twig:Panel title="Bearer token" subtitle="Only when the server takes a static token.">
            {{ form_row(form.token) }}
        </twig:Panel>

        <twig:Panel title="OAuth pre-registered client" subtitle="Optional. Without it, Reflex registers itself when the server allows it.">
            <div class="grid gap-5">
                {{ form_row(form.oauthClientId) }}
                {{ form_row(form.oauthClientSecret) }}
                {{ form_row(form.oauthIssuer) }}
            </div>
        </twig:Panel>

        <div class="flex items-center gap-3">
            <twig:Button variant="primary" type="submit">Connect</twig:Button>
            <a href="{{ path('app_connection_index') }}" class="text-sm text-slate-500 hover:text-ink">Cancel</a>
        </div>
    {{ form_end(form) }}
{% endblock %}
