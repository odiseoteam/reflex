{% extends 'base.html.twig' %}

{% block title %}{{ connection.name }} · Reflex{% endblock %}

{% block body %}
    <twig:PageHeader title="{{ connection.name }}" :crumbs="[{label: 'Connections', url: path('app_connection_index')}]">
        <twig:block name="badges">{{ include('connection/_status.html.twig', {status: connection.status}) }}</twig:block>
        <twig:block name="meta">
            <p class="mt-1 text-sm text-slate-500">
                <span class="font-mono text-xs">{{ connection.url }}</span> · {{ connection.auth.label }}
                {%- if connection.toolsSyncedAt %} · tools synced <twig:Time :at="connection.toolsSyncedAt" />{% endif %}
            </p>
        </twig:block>
        {% if is_granted('ROLE_ADMIN') %}
            <form method="post" action="{{ path('app_connection_sync', {id: connection.id}) }}" data-turbo="false">
                <input type="hidden" name="_token" value="{{ csrf_token('sync-' ~ connection.id) }}">
                <twig:Button variant="primary">{{ connection.status.value == 'connected' ? 'Refresh tools' : 'Connect' }}</twig:Button>
            </form>
            <form method="post" action="{{ path('app_connection_delete', {id: connection.id}) }}" onsubmit="return confirm('Remove this connection and its credentials?')">
                <input type="hidden" name="_token" value="{{ csrf_token('delete-' ~ connection.id) }}">
                <twig:Button variant="danger">Remove</twig:Button>
            </form>
        {% endif %}
    </twig:PageHeader>

    {% if connection.lastError %}
        <div class="mb-6 rounded-xl border border-red-200 bg-red-50 px-5 py-3 text-sm text-red-800">{{ connection.lastError }}</div>
    {% endif %}

    <twig:Panel title="Tools" subtitle="{{ connection.tools|length }} from this server. Reflexes see them prefixed with {{ connection.slug }}_." flush>
        {% if connection.tools is empty %}
            <p class="px-5 py-6 text-sm text-slate-500">No tools yet. Connect to load the catalog.</p>
        {% else %}
            <ul class="divide-y divide-hairline">
                {% for tool in connection.tools %}
                    {% set annotations = tool.annotations ?? {} %}
                    {% set properties = tool.inputSchema.properties ?? {} %}
                    <li class="grid gap-1 px-5 py-3.5">
                        <div class="flex flex-wrap items-center gap-1.5">
                            <code class="font-mono text-xs font-semibold">{{ connection.slug }}_{{ tool.name }}</code>
                            {% if annotations.readOnlyHint ?? false %}<twig:Pill tone="info">read-only</twig:Pill>{% endif %}
                            {% if annotations.destructiveHint ?? false %}<twig:Pill tone="danger">destructive</twig:Pill>{% endif %}
                            {% if annotations.idempotentHint ?? false %}<twig:Pill>idempotent</twig:Pill>{% endif %}
                        </div>
                        {% if tool.description ?? false %}<p class="text-sm text-slate-600">{{ tool.description }}</p>{% endif %}
                        {% if properties is not empty %}
                            <p class="text-xs text-slate-500">Arguments: {% for name in properties|keys %}<code class="font-mono">{{ name }}</code>{{ not loop.last ? ', ' }}{% endfor %}</p>
                        {% endif %}
                    </li>
                {% endfor %}
            </ul>
        {% endif %}
    </twig:Panel>
{% endblock %}
