{% extends 'base.html.twig' %}

{% block title %}Inbox · Reflex{% endblock %}

{% block body %}
    <h1 class="text-2xl font-semibold">Inbox</h1>
    <p class="mb-6 text-sm text-slate-600">What agents want to do and can't without you. An approval runs exactly the tool and arguments shown.</p>

    {% if pending is empty %}
        <div class="mb-8 rounded-lg border border-dashed border-slate-300 bg-white p-10 text-center text-slate-600">Nothing waits for you.</div>
    {% else %}
        <div class="mb-8">{{ include('decision/_list.html.twig', {decisions: pending}) }}</div>
    {% endif %}

    {% if decided is not empty %}
        <h2 class="mb-3 text-lg font-semibold">Recently decided</h2>
        {{ include('decision/_list.html.twig', {decisions: decided}) }}
    {% endif %}
{% endblock %}
