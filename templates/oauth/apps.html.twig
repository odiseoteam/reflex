{% extends 'base.html.twig' %}

{% block title %}Connected apps · Reflex{% endblock %}

{% block body %}
    <twig:PageHeader title="Connected apps" subtitle="MCP clients such as Claude or ChatGPT that act as you through Reflex's MCP server." />

    <div class="grid items-start gap-6 lg:grid-cols-[minmax(0,1.6fr)_minmax(0,1fr)]">
        <twig:Panel title="Your apps" flush class="lg:order-1">
            <ul class="divide-y divide-hairline text-sm">
                {% for grant in grants %}
                    <li class="flex flex-wrap items-center gap-3 px-5 py-3.5">
                        <div class="min-w-0 flex-1">
                            <p class="font-medium">{{ grant.client.name }}
                                {%- if grant.client.metadataDocument %} <span class="text-xs font-normal text-slate-500">{{ grant.client.clientId|split('/')[2] }}</span>{% endif %}
                            </p>
                            <p class="text-xs text-slate-500">
                                {% for scope in grant.scopes %}<code class="font-mono">{{ scope }}</code>{{ not loop.last ? ', ' }}{% endfor %}
                                · connected <twig:Time :at="grant.createdAt" />
                                · {% if grant.lastUsedAt %}last used <twig:Time :at="grant.lastUsedAt" />{% else %}not used yet{% endif %}
                            </p>
                        </div>
                        <form method="post" action="{{ path('app_connected_app_disconnect', {id: grant.id}) }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('disconnect-' ~ grant.id) }}">
                            <twig:Button variant="danger" size="sm">Disconnect</twig:Button>
                        </form>
                    </li>
                {% else %}
                    <li class="px-5 py-8 text-center text-slate-500">No apps connected.</li>
                {% endfor %}
            </ul>
        </twig:Panel>

        <twig:Panel title="Connect an app" subtitle="Add this URL as a remote MCP server; the app sends you here to sign in and choose what it may do." class="lg:order-2">
            <twig:CopyCode text="{{ mcp_url }}" />
            <p class="mt-3 text-xs text-slate-500">In Claude Code:</p>
            <twig:CopyCode text="claude mcp add --transport http reflex {{ mcp_url }}" class="mt-1" />
        </twig:Panel>
    </div>
{% endblock %}
