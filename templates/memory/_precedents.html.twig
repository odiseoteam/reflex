{# items: Precedent or Recollection (a precedent with its distance); shown inside a panel #}
{% set tones = {approved: 'success', answered: 'question', rejected: 'danger', declined: 'warning'} %}
<ul class="-my-1 divide-y divide-hairline text-sm">
    {% for item in items %}
        {% set precedent = item.precedent ?? item %}
        <li class="grid gap-1 py-3">
            <div class="flex flex-wrap items-center gap-2">
                <twig:Pill tone="{{ tones[precedent.verdict.value] }}">{{ precedent.verdict.value|capitalize }}</twig:Pill>
                <code class="font-mono text-xs">{{ precedent.toolName }}</code>
                <span class="text-xs text-slate-500">
                    by {{ precedent.decidedBy }} · <twig:Time :at="precedent.decidedAt" format="date" />
                    {%- if item.distance is defined %} · {{ ((1 - item.distance) * 100)|round }}% similar{% endif %}
                    {%- if not precedent.hasEmbedding %} · not indexed yet{% endif %}
                </span>
                {% if precedent.decision %}
                    <a class="ml-auto text-xs font-medium text-accent hover:underline" href="{{ path('app_decision_show', {id: precedent.decision.id}) }}">Decision</a>
                {% endif %}
            </div>
            <p class="text-slate-700">{{ precedent.reason }}</p>
            {% if precedent.note %}<p class="whitespace-pre-line text-slate-500">“{{ precedent.note }}”</p>{% endif %}
            {% if precedent.answer %}<pre class="overflow-auto rounded-lg bg-slate-50 p-2 font-mono text-xs">{{ precedent.answer|json_encode(constant('JSON_UNESCAPED_SLASHES') b-or constant('JSON_UNESCAPED_UNICODE')) }}</pre>{% endif %}
        </li>
    {% else %}
        <li class="py-3 text-slate-500">{{ empty|default('Nothing yet.') }}</li>
    {% endfor %}
</ul>
