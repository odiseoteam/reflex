{% extends 'base.html.twig' %}

{% block title %}Home · Reflex{% endblock %}

{% block body %}
    <twig:PageHeader :breadcrumb="false" title="Hi, {{ app.user.name|split(' ')|first }}">
        <twig:block name="meta"><p class="mt-1 text-sm text-slate-500"><twig:Time at="now" format="day" /> · {{ enabled_reflexes }} {{ enabled_reflexes == 1 ? 'reflex' : 'reflexes' }} on</p></twig:block>
        {% if is_granted('ROLE_ADMIN') %}
            <twig:Button variant="primary" type="button" popovertarget="simulate">Simulate event</twig:Button>
        {% endif %}
    </twig:PageHeader>

    {% if is_granted('ROLE_ADMIN') %}
        <div id="simulate" popover class="m-auto w-[min(38rem,calc(100vw-2rem))] rounded-xl border border-hairline bg-white p-0 text-ink shadow-xl backdrop:bg-slate-900/30">
            <div class="flex items-start justify-between gap-4 border-b border-hairline px-5 py-4">
                <div>
                    <h2 class="font-semibold">Simulate an event</h2>
                    <p class="text-sm text-slate-500">Make something happen at {{ company_name|default('the demo company') }} and watch its reflex react.</p>
                </div>
                <button type="button" popovertarget="simulate" popovertargetaction="hide" aria-label="Close" class="grid size-8 place-items-center rounded-md text-slate-500 hover:bg-slate-100 hover:text-ink">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg>
                </button>
            </div>
            <form method="post" action="{{ path('app_simulate') }}">
                <input type="hidden" name="_token" value="{{ csrf_token('simulate') }}">
                <ul class="divide-y divide-hairline">
                    {% for name, description in scenarios %}
                        <li class="flex flex-wrap items-center gap-3 px-5 py-3.5">
                            <div class="min-w-0 flex-1">
                                <div class="text-sm font-semibold">{{ name|replace({'-': ' '})|capitalize }}</div>
                                <p class="text-xs text-slate-500">{{ description }}</p>
                            </div>
                            {% if name == 'payment-failed' %}
                                <label class="sr-only" for="simulate-customer">Customer</label>
                                <select id="simulate-customer" name="customer" class="rounded-md border border-hairline px-2 py-1 text-[13px]">
                                    {% for key, label in recorded_customers %}<option value="{{ key }}">{{ label }}</option>{% endfor %}
                                </select>
                            {% endif %}
                            <twig:Button size="sm" name="scenario" value="{{ name }}">Simulate</twig:Button>
                        </li>
                    {% endfor %}
                </ul>
            </form>
        </div>
    {% endif %}

    <div class="mb-4 grid grid-cols-2 gap-4 lg:grid-cols-4">
        <div class="rounded-xl border bg-white px-5 py-4 {{ stats.pendingDecisions > 0 ? 'border-amber-200' : 'border-hairline' }}">
            <div class="text-sm text-slate-500">Pending decisions</div>
            <div class="mt-0.5 text-3xl font-semibold tracking-tight tabular-nums {{ stats.pendingDecisions > 0 ? 'text-amber-700' }}">{{ stats.pendingDecisions }}</div>
            <div class="text-xs text-slate-500">to approve or reject</div>
        </div>
        <div class="rounded-xl border border-hairline bg-white px-5 py-4">
            <div class="text-sm text-slate-500">Runs today</div>
            <div class="mt-0.5 text-3xl font-semibold tracking-tight tabular-nums">{{ stats.runs }}</div>
            <div class="text-xs text-slate-500">{{ stats.finishedRuns }} finished · {{ stats.waitingRuns }} waiting</div>
        </div>
        <div class="rounded-xl border border-hairline bg-white px-5 py-4">
            <div class="text-sm text-slate-500">Automatic actions</div>
            <div class="mt-0.5 text-3xl font-semibold tracking-tight tabular-nums">{{ stats.toolCalls }}</div>
            <div class="text-xs text-slate-500">ran today without approval</div>
        </div>
        <div class="rounded-xl border border-hairline bg-white px-5 py-4">
            <div class="text-sm text-slate-500">Tokens today</div>
            <div class="mt-0.5 text-3xl font-semibold tracking-tight tabular-nums">{{ stats.tokens|number_format(0, '.', ',') }}</div>
            {% if stats.budgetPercent is not null %}
                <div class="mt-2 h-1 overflow-hidden rounded bg-slate-100"><div class="h-full bg-accent" style="width: {{ stats.budgetPercent }}%"></div></div>
            {% else %}
                <div class="text-xs text-slate-500">no daily budget set</div>
            {% endif %}
        </div>
    </div>

    <div class="grid items-stretch gap-4 lg:grid-cols-2">
        <twig:Panel title="Pending decisions" subtitle="Actions waiting for your approval." flush>
            <twig:block name="actions"><a href="{{ path('app_decision_index') }}" class="shrink-0 text-sm font-medium text-accent hover:underline">All decisions</a></twig:block>
            {% if pending is empty %}
                <p class="px-5 py-8 text-center text-sm text-slate-500">Nothing waits for you.</p>
            {% else %}
                <ol class="divide-y divide-hairline" aria-label="Pending decisions">
                    {% for decision in pending %}
                        <li class="flex items-start gap-4 px-5 py-3.5">
                            <div class="min-w-0 flex-1">
                                <p class="line-clamp-2 text-sm">{{ decision.question ? decision.question.message : decision.reason }}</p>
                                <div class="mt-1.5 flex flex-wrap items-center gap-x-2 gap-y-1 text-xs text-slate-500">
                                    <twig:ReflexLabel name="{{ decision.run.reflexSnapshot.name }}" />
                                    <span class="tabular-nums"><twig:Time :at="decision.createdAt" format="time" /></span>
                                </div>
                            </div>
                            <twig:Button href="{{ path('app_decision_show', {id: decision.id}) }}" size="sm" class="shrink-0">View details</twig:Button>
                        </li>
                    {% endfor %}
                </ol>
            {% endif %}
        </twig:Panel>

        <twig:Panel title="Latest runs" subtitle="What reflexes did, and what their policy let them do." flush>
            <twig:block name="actions"><a href="{{ path('app_run_index') }}" class="shrink-0 text-sm font-medium text-accent hover:underline">All runs</a></twig:block>
            {% if runs is empty %}
                <p class="px-5 py-8 text-center text-sm text-slate-500">No runs yet. Simulate an event to see a reflex run.</p>
            {% else %}
                <ol class="divide-y divide-hairline" aria-label="Latest runs">
                    {% for run in runs %}
                        <li>
                            <a href="{{ path('app_run_show', {id: run.id}) }}" class="grid gap-1 px-5 py-3 hover:bg-slate-50">
                                <span class="flex items-center justify-between gap-3">
                                    <twig:ReflexLabel name="{{ run.reflexSnapshot.name }}" />
                                    {{ include('reflex/_run_status.html.twig', {status: run.status}) }}
                                </span>
                                <span class="truncate text-xs text-slate-500">{{ include('run/_trigger.html.twig') }} · <twig:Time :at="run.createdAt" format="time" /></span>
                                <span class="text-xs">{{ include('run/_policy_summary.html.twig', {counts: steps[run.id.toRfc4122] ?? {}}) }}</span>
                            </a>
                        </li>
                    {% endfor %}
                </ol>
            {% endif %}
        </twig:Panel>
    </div>
{% endblock %}
