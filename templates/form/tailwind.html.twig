{% use 'tailwind_2_layout.html.twig' %}

{%- block widget_attributes -%}
    {%- set widget_class = widget_class|default('mt-1.5 block w-full rounded-md border border-hairline bg-white px-3 py-2 text-sm text-ink focus:border-accent focus:outline-none focus:ring-2 focus:ring-accent/15') -%}
    {{- parent() -}}
{%- endblock widget_attributes -%}

{%- block form_label -%}
    {%- set label_class = label_class|default('block text-sm font-medium text-ink') -%}
    {{- parent() -}}
{%- endblock form_label -%}

{%- block form_help -%}
    {%- set help_class = help_class|default('mt-1.5 text-xs text-slate-500') -%}
    {{- parent() -}}
{%- endblock form_help -%}

{%- block form_errors -%}
    {%- set error_item_class = error_item_class|default('mt-1.5 text-sm text-red-700') -%}
    {{- parent() -}}
{%- endblock form_errors -%}

{%- block choice_widget_expanded -%}
    <div {{ block('widget_container_attributes') }} class="mt-2 flex flex-wrap gap-x-5 gap-y-2">
        {%- for child in form %}
            <label class="flex items-center gap-2 text-sm">
                {{- form_widget(child, {widget_class: 'size-4 accent-accent'}) -}}
                {{ child.vars.label|trans }}
            </label>
        {% endfor -%}
    </div>
{%- endblock choice_widget_expanded -%}

{%- block checkbox_row -%}
    {%- set widget_attr = help ? {attr: {'aria-describedby': id ~ '_help'}} : {} -%}
    <div{% with {attr: row_attr} %}{{ block('attributes') }}{% endwith %}>
        {{- form_errors(form) -}}
        <div class="flex items-center gap-2">
            {{- form_widget(form, widget_attr) -}}
            {{- form_label(form) -}}
        </div>
        {{- form_help(form) -}}
    </div>
{%- endblock checkbox_row -%}

{%- block checkbox_widget -%}
    {%- set widget_class = widget_class|default('size-4 accent-accent') -%}
    {{- parent() -}}
{%- endblock checkbox_widget -%}
