{# A white panel with an optional heading row; flush drops the inner padding for tables and lists #}
{% props title = null, subtitle = null, flush = false %}
<section {{ attributes.defaults({class: 'overflow-hidden rounded-xl border border-hairline bg-white'}) }}>
    {% if title %}
        <div class="flex flex-wrap items-center justify-between gap-x-4 gap-y-2 border-b border-hairline px-5 py-4">
            <div class="min-w-0">
                <h2 class="font-semibold">{{ title }}</h2>
                {% if subtitle %}<p class="text-sm text-slate-500">{{ subtitle }}</p>{% endif %}
            </div>
            {% block actions %}{% endblock %}
        </div>
    {% endif %}
    <div class="{{ flush ? '' : 'px-5 py-4' }}">{% block content %}{% endblock %}</div>
</section>
