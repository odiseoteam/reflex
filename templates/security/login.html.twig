{% extends 'base.html.twig' %}

{% block title %}Sign in · Reflex{% endblock %}

{% block body %}
    {% set field = 'mt-1.5 block w-full rounded-md border border-hairline bg-white px-3 py-2 text-sm focus:border-accent focus:outline-none focus:ring-2 focus:ring-accent/15' %}
    <div class="mx-auto mt-6 grid max-w-sm gap-4">
        <form method="post" action="{{ path('app_login') }}" class="grid gap-5 rounded-xl border border-hairline bg-white p-6">
            <div>
                <h1 class="text-xl font-semibold tracking-tight">Sign in</h1>
                {% if company_name is not empty %}<p class="mt-1 text-sm text-slate-500">to Reflex at {{ company_name }}</p>{% endif %}
            </div>

            {% if error %}
                <div class="rounded-lg bg-red-50 px-3 py-2 text-sm text-red-800">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
            {% endif %}

            <div>
                <label for="username" class="block text-sm font-medium">Email</label>
                <input type="email" id="username" name="_username" value="{{ last_username }}" autocomplete="email" required autofocus class="{{ field }}">
            </div>
            <div>
                <label for="password" class="block text-sm font-medium">Password</label>
                <input type="password" id="password" name="_password" autocomplete="current-password" required class="{{ field }}">
            </div>
            <label class="flex items-center gap-2 text-sm text-slate-600">
                <input type="checkbox" name="_remember_me" class="size-4 accent-accent"> Keep me signed in
            </label>

            <input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('authenticate') }}">

            <twig:Button variant="primary" type="submit" class="w-full">Sign in</twig:Button>
        </form>
    </div>
{% endblock %}
