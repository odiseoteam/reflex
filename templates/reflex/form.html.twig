{% extends 'base.html.twig' %}

{% form_theme form 'form/tailwind.html.twig' %}

{% block title %}{{ reflex ? 'Edit ' ~ reflex.name : 'New reflex' }} · Reflex{% endblock %}

{% block body %}
    <h1 class="mb-6 text-2xl font-semibold">{{ reflex ? 'Edit ' ~ reflex.name : 'New reflex' }}</h1>

    {{ form_start(form, {attr: {class: 'max-w-2xl space-y-5 rounded-lg border border-slate-200 bg-white p-6'}}) }}
        {{ form_row(form.name) }}
        <div class="grid gap-4 sm:grid-cols-2">
            {{ form_row(form.triggerSource) }}
            {{ form_row(form.triggerEvent) }}
        </div>
        {{ form_row(form.instructions) }}
        {{ form_row(form.model) }}
        {{ form_row(form.connections) }}
        {{ form_row(form.enabled) }}

        <div class="flex items-center gap-3">
            <button type="submit" class="rounded-md bg-slate-900 px-4 py-2 text-sm font-medium text-white hover:bg-slate-700">Save</button>
            <a href="{{ reflex ? path('app_reflex_show', {id: reflex.id}) : path('app_reflex_index') }}" class="text-sm text-slate-600 hover:text-slate-900">Cancel</a>
        </div>
    {{ form_end(form) }}
{% endblock %}
