{% extends 'base.html.twig' %}

{% block title %}Reflexes · Reflex{% endblock %}

{% block body %}
    <twig:PageHeader title="Reflexes" subtitle="Agents that act on their own when something happens, within a policy per tool.">
        {% if is_granted('ROLE_ADMIN') %}
            <twig:Button href="{{ path('app_reflex_new') }}" variant="primary">New reflex</twig:Button>
        {% endif %}
    </twig:PageHeader>

    <twig:Panel flush>
        {% if reflexes is empty %}
            <p class="px-5 py-10 text-center text-sm text-slate-500">No reflexes yet. Create one, or set up the demo company with <code class="font-mono text-xs">bin/console reflex:demo:setup</code>.</p>
        {% else %}
            <table class="w-full text-sm">
                <thead class="bg-slate-50 text-left text-xs text-slate-500">
                    <tr>
                        <th class="px-5 py-2.5 font-medium">Reflex</th>
                        <th class="hidden px-5 py-2.5 font-medium md:table-cell">Model</th>
                        <th class="hidden px-5 py-2.5 font-medium sm:table-cell">Last run</th>
                        <th class="px-5 py-2.5 font-medium">Status</th>
                        <th class="py-2.5 pl-2 pr-4"><span class="sr-only">Actions</span></th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-hairline">
                    {% for reflex in reflexes %}
                        {% set last_run = last_runs[reflex.id.toRfc4122] ?? null %}
                        <tr class="hover:bg-slate-50">
                            <td class="w-full max-w-0 px-5 py-3.5">
                                <a href="{{ path('app_reflex_show', {id: reflex.id}) }}" class="font-medium hover:underline">{{ reflex.name }}</a>
                                <div class="truncate text-xs text-slate-500">{{ include('reflex/_trigger.html.twig') }}</div>
                            </td>
                            <td class="hidden whitespace-nowrap px-5 py-3.5 font-mono text-xs text-slate-500 md:table-cell">{{ reflex.model }}</td>
                            <td class="hidden whitespace-nowrap px-5 py-3.5 text-slate-500 tabular-nums sm:table-cell">{% if last_run %}<twig:Time :at="last_run" />{% else %}Never{% endif %}</td>
                            <td class="px-5 py-3.5"><twig:Pill tone="{{ reflex.enabled ? 'success' : 'neutral' }}">{{ reflex.enabled ? 'On' : 'Off' }}</twig:Pill></td>
                            <td class="w-px py-3.5 pl-2 pr-4 text-right"><twig:Button href="{{ path('app_reflex_show', {id: reflex.id}) }}" size="sm">Open</twig:Button></td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% endif %}
    </twig:Panel>
{% endblock %}
