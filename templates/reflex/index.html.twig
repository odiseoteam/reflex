{% extends 'base.html.twig' %}

{% block title %}Reflexes · Reflex{% endblock %}

{% block body %}
    <div class="mb-6 flex items-center justify-between">
        <div>
            <h1 class="text-2xl font-semibold">Reflexes</h1>
            <p class="text-sm text-slate-600">What agents do on their own when something happens.</p>
        </div>
        {% if is_granted('ROLE_ADMIN') %}
        <a href="{{ path('app_reflex_new') }}" class="rounded-md bg-slate-900 px-4 py-2 text-sm font-medium text-white hover:bg-slate-700">New reflex</a>
        {% endif %}
    </div>

    {% if reflexes is empty %}
        <div class="mb-8 rounded-lg border border-dashed border-slate-300 bg-white p-10 text-center text-slate-600">
            No reflexes yet.
        </div>
    {% else %}
        <ul class="mb-8 divide-y divide-slate-200 overflow-hidden rounded-lg border border-slate-200 bg-white">
            {% for reflex in reflexes %}
                <li>
                    <a href="{{ path('app_reflex_show', {id: reflex.id}) }}" class="flex items-center justify-between px-4 py-3 hover:bg-slate-50">
                        <div>
                            <div class="font-medium">{{ reflex.name }}</div>
                            <div class="text-sm text-slate-500">{{ include('reflex/_trigger.html.twig') }}</div>
                        </div>
                        <span class="text-xs {{ reflex.enabled ? 'text-emerald-700' : 'text-slate-500' }}">{{ reflex.enabled ? 'Enabled' : 'Disabled' }}</span>
                    </a>
                </li>
            {% endfor %}
        </ul>
    {% endif %}

    <h2 class="mb-3 text-lg font-semibold">Latest runs</h2>
    {{ include('reflex/_runs.html.twig') }}
{% endblock %}
