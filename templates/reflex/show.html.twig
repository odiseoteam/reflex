{% extends 'base.html.twig' %}

{% block title %}{{ reflex.name }} · Reflex{% endblock %}

{% block body %}
    {% set admin = is_granted('ROLE_ADMIN') %}
    <twig:PageHeader title="{{ reflex.name }}" :crumbs="[{label: 'Reflexes', url: path('app_reflex_index')}]">
        <twig:block name="badges"><twig:Pill tone="{{ reflex.enabled ? 'success' : 'neutral' }}">{{ reflex.enabled ? 'On' : 'Off' }}</twig:Pill></twig:block>
        <twig:block name="meta"><p class="mt-1 text-sm text-slate-500">{{ include('reflex/_trigger.html.twig') }}</p></twig:block>
        {% if admin %}
            {% if can_run_by_hand %}
                <form method="post" action="{{ path('app_reflex_run', {id: reflex.id}) }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('run-' ~ reflex.id) }}">
                    <twig:Button variant="primary">Run now</twig:Button>
                </form>
            {% else %}
                {# The span shows the tooltip: some browsers ignore title on disabled buttons #}
                <span title="Runs on its events only: running it by hand needs an API key for its model." class="cursor-not-allowed">
                    <twig:Button variant="primary" type="button" disabled class="pointer-events-none opacity-40">Run now</twig:Button>
                </span>
            {% endif %}
            <twig:Button href="{{ path('app_reflex_edit', {id: reflex.id}) }}">Edit</twig:Button>
        {% endif %}
    </twig:PageHeader>

    {% if reflex.disabledReason %}
        <div class="mb-6 rounded-xl border border-amber-200 bg-amber-50 px-5 py-3 text-sm text-amber-900">{{ reflex.disabledReason }} Fix the cause and enable it again in Edit.</div>
    {% endif %}

    <div class="grid items-start gap-6 lg:grid-cols-[minmax(0,1.6fr)_minmax(0,1fr)]">
        <div class="grid gap-6">
            <twig:Panel title="Instructions" subtitle="What the agent is told to do when it fires.">
                <div class="markdown text-sm text-slate-700">{{ reflex.instructions|markdown_to_html }}</div>
            </twig:Panel>

            <twig:Panel title="Tool policy" subtitle="Enforced in code, not in the prompt: forbidden tools don't exist for the agent, and tools that need approval only record a proposal." flush>
                {% if tools is empty %}
                    <p class="px-5 py-6 text-sm text-slate-500">No tools. Pick connected systems in <a class="font-medium text-accent hover:underline" href="{{ path('app_reflex_edit', {id: reflex.id}) }}">Edit</a>.</p>
                {% else %}
                    {% set tones = {auto: 'border-emerald-200 bg-emerald-50 text-emerald-800', approval: 'border-amber-200 bg-amber-50 text-amber-900', forbidden: 'border-red-200 bg-red-50 text-red-800'} %}
                    <form method="post" action="{{ path('app_reflex_policy', {id: reflex.id}) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('policy-' ~ reflex.id) }}">
                        <div class="overflow-x-auto">
                            <table class="w-full text-sm">
                                <thead class="bg-slate-50 text-left text-xs text-slate-500">
                                    <tr>
                                        <th class="px-5 py-2.5 font-medium">Tool</th>
                                        <th class="px-3 py-2.5 font-medium">Policy</th>
                                        <th class="py-2.5 pl-3 pr-5 font-medium" title="Admins who must approve before it runs">Approvals</th>
                                    </tr>
                                </thead>
                                <tbody class="divide-y divide-hairline">
                                    {% for tool in tools %}
                                        <tr>
                                            <td class="w-full max-w-0 px-5 py-3">
                                                <div class="flex flex-wrap items-center gap-1.5">
                                                    <code class="font-mono text-xs font-semibold">{{ tool.name }}</code>
                                                    {% if tool.annotations.readOnlyHint ?? false %}<twig:Pill tone="info">read-only</twig:Pill>{% endif %}
                                                    {% if tool.annotations.destructiveHint ?? false %}<twig:Pill tone="danger">destructive</twig:Pill>{% endif %}
                                                </div>
                                                <div class="truncate text-xs text-slate-500" title="{{ tool.description }}">{{ tool.connection }} · {{ tool.description }}</div>
                                            </td>
                                            <td class="px-3 py-3">
                                                <label class="sr-only" for="policy-{{ loop.index }}">Policy for {{ tool.name }}</label>
                                                <select id="policy-{{ loop.index }}" name="policies[{{ tool.name }}]" class="rounded-md border px-2 py-1 text-[13px] font-medium {{ tones[tool.policy.value] }}" {{ admin ? '' : 'disabled' }}>
                                                    {% for policy in policies %}
                                                        <option value="{{ policy.value }}" {{ policy == tool.policy ? 'selected' }}>{{ policy.label }}{{ policy == tool.policy and not tool.configured ? ' (default)' }}</option>
                                                    {% endfor %}
                                                </select>
                                            </td>
                                            <td class="py-3 pl-3 pr-5">
                                                <label class="sr-only" for="approvals-{{ loop.index }}">Approvals for {{ tool.name }}</label>
                                                <input id="approvals-{{ loop.index }}" type="number" name="approvals[{{ tool.name }}]" value="{{ tool.approvals }}" min="1" max="{{ constant('App\\Entity\\Reflex::MAX_APPROVALS') }}"
                                                       class="w-16 rounded-md border border-hairline px-2 py-1 text-[13px] tabular-nums" {{ admin ? '' : 'disabled' }}>
                                            </td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                        <div class="flex flex-wrap items-center justify-between gap-3 border-t border-hairline bg-slate-50 px-5 py-3">
                            <p class="text-xs text-slate-500">Tools left unset are automatic when read-only, and need approval otherwise.</p>
                            {% if admin %}<twig:Button variant="primary" size="sm">Save policy</twig:Button>{% endif %}
                        </div>
                    </form>
                {% endif %}
            </twig:Panel>
        </div>

        <div class="grid gap-6">
            <twig:Panel title="Details">
                <dl class="grid grid-cols-[auto_minmax(0,1fr)] gap-x-4 gap-y-2 text-sm">
                    <dt class="text-slate-500">Model</dt>
                    <dd class="truncate font-mono text-xs leading-5">{{ reflex.model }}</dd>
                    <dt class="text-slate-500">Connections</dt>
                    <dd>{{ reflex.connections|map(connection => connection.name)|join(', ')|default('None') }}</dd>
                    <dt class="text-slate-500">Limits</dt>
                    <dd>{{ reflex.maxToolCalls }} tool calls and {{ reflex.timeLimitSeconds }} s per run</dd>
                    <dt class="text-slate-500">Tokens today</dt>
                    <dd class="tabular-nums">
                        {{ tokensToday|number_format(0, '.', ',') }}{{ reflex.dailyTokenBudget ? ' of ' ~ reflex.dailyTokenBudget|number_format(0, '.', ',') : ', no budget' }}
                        {% if reflex.dailyTokenBudget %}
                            <div class="mt-1.5 h-1 overflow-hidden rounded bg-slate-100"><div class="h-full bg-accent" style="width: {{ min(100, (tokensToday * 100 / reflex.dailyTokenBudget)|round) }}%"></div></div>
                        {% endif %}
                    </dd>
                </dl>
            </twig:Panel>

            <twig:Panel title="Latest runs" flush>
                <twig:block name="actions"><a href="{{ path('app_run_index', {reflex: reflex.id}) }}" class="text-sm font-medium text-accent hover:underline">All runs</a></twig:block>
                {{ include('reflex/_runs.html.twig') }}
            </twig:Panel>

            <twig:Panel title="Memory" subtitle="What people decided on its proposals. Each run gets the closest ones to its event.">
                {{ include('memory/_precedents.html.twig', {items: memory, empty: 'Nothing decided yet.'}) }}
            </twig:Panel>
        </div>
    </div>
{% endblock %}
