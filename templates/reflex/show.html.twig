{% extends 'base.html.twig' %}

{% block title %}{{ reflex.name }} · Reflex{% endblock %}

{% block body %}
    <div class="mb-6 flex flex-wrap items-start justify-between gap-4">
        <div>
            <h1 class="text-2xl font-semibold">{{ reflex.name }}</h1>
            <p class="text-sm text-slate-600">
                {{ include('reflex/_trigger.html.twig') }} · {{ reflex.model }} ·
                <span class="{{ reflex.enabled ? 'text-emerald-700' : 'text-slate-500' }}">{{ reflex.enabled ? 'Enabled' : 'Disabled' }}</span>
            </p>
        </div>
        {% if is_granted('ROLE_ADMIN') %}
        <div class="flex items-center gap-2">
            <form method="post" action="{{ path('app_reflex_run', {id: reflex.id}) }}">
                <input type="hidden" name="_token" value="{{ csrf_token('run-' ~ reflex.id) }}">
                <button class="rounded-md bg-slate-900 px-4 py-2 text-sm font-medium text-white hover:bg-slate-700">Run now</button>
            </form>
            <a href="{{ path('app_reflex_edit', {id: reflex.id}) }}" class="rounded-md border border-slate-300 px-4 py-2 text-sm text-slate-700 hover:bg-slate-100">Edit</a>
        </div>
        {% endif %}
    </div>

    {% if reflex.disabledReason %}
        <div class="mb-6 rounded-md bg-amber-50 px-4 py-3 text-sm text-amber-900">{{ reflex.disabledReason }} Fix the cause and enable it again in Edit.</div>
    {% endif %}

    <p class="mb-6 text-sm text-slate-600">
        Limits: {{ reflex.maxToolCalls }} tool calls and {{ reflex.timeLimitSeconds }} s per run ·
        {{ reflex.dailyTokenBudget ? (tokensToday|number_format ~ ' of ' ~ reflex.dailyTokenBudget|number_format ~ ' tokens today') : tokensToday|number_format ~ ' tokens today, no budget' }}
    </p>

    <section class="mb-8">
        <h2 class="mb-2 text-lg font-semibold">Instructions</h2>
        <div class="whitespace-pre-line rounded-lg border border-slate-200 bg-white p-4 text-sm">{{ reflex.instructions }}</div>
    </section>

    <section class="mb-8">
        <h2 class="mb-1 text-lg font-semibold">Tool policy</h2>
        <p class="mb-3 text-sm text-slate-600">Enforced in code. Forbidden tools are never shown to the agent; tools that need approval only record a proposal. Unset tools default to automatic when read-only, approval otherwise.</p>

        {% if tools is empty %}
            <p class="text-sm text-slate-600">No tools. Pick connected systems in <a class="underline" href="{{ path('app_reflex_edit', {id: reflex.id}) }}">Edit</a>.</p>
        {% else %}
            <form method="post" action="{{ path('app_reflex_policy', {id: reflex.id}) }}" class="overflow-hidden rounded-lg border border-slate-200 bg-white">
                <input type="hidden" name="_token" value="{{ csrf_token('policy-' ~ reflex.id) }}">
                <table class="w-full text-sm">
                    <thead class="bg-slate-50 text-left text-xs uppercase text-slate-500">
                        <tr><th class="px-4 py-2">Tool</th><th class="px-4 py-2">Policy</th><th class="px-4 py-2" title="Admins who must approve before it runs">Approvals</th></tr>
                    </thead>
                    <tbody class="divide-y divide-slate-200">
                        {% for tool in tools %}
                            <tr>
                                <td class="px-4 py-2">
                                    <code class="font-semibold">{{ tool.name }}</code>
                                    {% if tool.annotations.readOnlyHint ?? false %}<span class="ml-1 rounded bg-sky-100 px-1.5 py-0.5 text-xs text-sky-800">read-only</span>{% endif %}
                                    {% if tool.annotations.destructiveHint ?? false %}<span class="ml-1 rounded bg-red-100 px-1.5 py-0.5 text-xs text-red-800">destructive</span>{% endif %}
                                    <div class="text-xs text-slate-500">{{ tool.connection }} · {{ tool.description|length > 120 ? tool.description|slice(0, 120) ~ '…' : tool.description }}</div>
                                </td>
                                <td class="px-4 py-2">
                                    <select name="policies[{{ tool.name }}]" class="rounded-md border border-slate-300 px-2 py-1 text-sm" {{ is_granted('ROLE_ADMIN') ? '' : 'disabled' }}>
                                        {% for policy in policies %}
                                            <option value="{{ policy.value }}" {{ policy == tool.policy ? 'selected' }}>{{ policy.label }}{{ policy == tool.policy and not tool.configured ? ' (default)' }}</option>
                                        {% endfor %}
                                    </select>
                                </td>
                                <td class="px-4 py-2">
                                    <input type="number" name="approvals[{{ tool.name }}]" value="{{ tool.approvals }}" min="1" max="{{ constant('App\\Entity\\Reflex::MAX_APPROVALS') }}"
                                           class="w-16 rounded-md border border-slate-300 px-2 py-1 text-sm" {{ is_granted('ROLE_ADMIN') ? '' : 'disabled' }}>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
                {% if is_granted('ROLE_ADMIN') %}
                <div class="border-t border-slate-200 bg-slate-50 px-4 py-3">
                    <button class="rounded-md bg-slate-900 px-4 py-2 text-sm font-medium text-white hover:bg-slate-700">Save policy</button>
                </div>
                {% endif %}
            </form>
        {% endif %}
    </section>

    <section class="mb-8">
        <h2 class="mb-1 text-lg font-semibold">Memory</h2>
        <p class="mb-2 text-sm text-slate-600">What people decided on its proposals. Each run is given the closest ones to its event.</p>
        {{ include('memory/_precedents.html.twig', {items: memory, empty: 'Nothing decided yet.'}) }}
    </section>

    <section>
        <h2 class="mb-3 text-lg font-semibold">Runs</h2>
        {{ include('reflex/_runs.html.twig') }}
    </section>
{% endblock %}
