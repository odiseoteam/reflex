{# runs: the latest runs of one reflex, shown inside a panel #}
{% if runs is empty %}
    <p class="px-5 py-6 text-sm text-slate-500">No runs yet.</p>
{% else %}
    <ul class="divide-y divide-hairline">
        {% for run in runs %}
            <li>
                <a href="{{ path('app_run_show', {id: run.id}) }}" class="flex items-center justify-between gap-3 px-5 py-3 hover:bg-slate-50">
                    <span class="min-w-0">
                        <span class="block truncate text-sm">{{ include('run/_trigger.html.twig') }}</span>
                        <span class="block text-xs text-slate-500 tabular-nums"><twig:Time :at="run.createdAt" /> · {{ run.steps|length }} {{ run.steps|length == 1 ? 'step' : 'steps' }}</span>
                    </span>
                    {{ include('reflex/_run_status.html.twig', {status: run.status}) }}
                </a>
            </li>
        {% endfor %}
    </ul>
{% endif %}
