{% extends 'base.html.twig' %}

{% block title %}Run · {{ run.reflexSnapshot.name }} · Reflex{% endblock %}

{% block body %}
    {# Refresh until the worker finishes #}
    {% if run.status.value in ['queued', 'running'] %}
        <meta http-equiv="refresh" content="2">
    {% endif %}

    <div class="mb-6">
        <a href="{{ path('app_reflex_show', {id: run.reflex.id}) }}" class="text-sm text-slate-600 hover:text-slate-900">← {{ run.reflex.name }}</a>
        <div class="mt-1 flex items-center gap-3">
            <h1 class="text-2xl font-semibold">Run</h1>
            {{ include('reflex/_run_status.html.twig', {status: run.status}) }}
        </div>
        <p class="text-sm text-slate-600">
            {{ run.event ? 'Triggered by ' ~ run.event.source ~ ' · ' ~ run.event.type : 'Manual run' }}
            · created {{ run.createdAt|date('Y-m-d H:i:s') }}
            {% if run.finishedAt %}· finished {{ run.finishedAt|date('H:i:s') }}{% endif %}
            · {{ run.reflexSnapshot.model }}
            {% if run.tokensUsed is not null %}· {{ run.tokensUsed|number_format }} tokens{% endif %}
            {% if run.attempts > 1 %}· resumed {{ run.attempts - 1 }}×{% endif %}
        </p>
    </div>

    {% if run.event %}
        <section class="mb-6">
            <h2 class="mb-2 text-lg font-semibold">Event <span class="text-xs font-normal text-slate-500">untrusted data</span></h2>
            <pre class="max-h-64 overflow-auto rounded-lg border border-slate-200 bg-white p-4 text-xs">{{ run.event.payload|json_encode(constant('JSON_PRETTY_PRINT') b-or constant('JSON_UNESCAPED_SLASHES') b-or constant('JSON_UNESCAPED_UNICODE')) }}</pre>
        </section>
    {% endif %}

    {% if recalled is not empty %}
        <section class="mb-6">
            <h2 class="mb-1 text-lg font-semibold">Recalled from memory</h2>
            <p class="mb-2 text-sm text-slate-600">Past decisions on similar events, given to the agent as precedent.</p>
            {{ include('memory/_precedents.html.twig', {items: recalled}) }}
        </section>
    {% endif %}

    <section class="mb-6">
        <h2 class="mb-2 text-lg font-semibold">Steps</h2>
        {% if run.steps is empty %}
            <p class="text-sm text-slate-600">No tool calls{{ run.status.finished ? '.' : ' yet…' }}</p>
        {% else %}
            {% set kinds = {
                tool_call: 'bg-emerald-100 text-emerald-800',
                proposal: 'bg-amber-100 text-amber-800',
                blocked: 'bg-red-100 text-red-800',
                error: 'bg-red-100 text-red-800',
            } %}
            <ol class="space-y-3">
                {% for step in run.steps %}
                    <li class="rounded-lg border border-slate-200 bg-white p-4">
                        <div class="flex items-center gap-2">
                            <span class="text-xs text-slate-500">#{{ step.position }}</span>
                            <span class="rounded px-1.5 py-0.5 text-xs {{ kinds[step.kind.value] }}">{{ step.kind.label }}</span>
                            <code class="text-sm font-semibold">{{ step.toolName }}</code>
                        </div>
                        <pre class="mt-2 overflow-auto rounded bg-slate-50 p-2 text-xs">{{ step.arguments|json_encode(constant('JSON_PRETTY_PRINT') b-or constant('JSON_UNESCAPED_SLASHES') b-or constant('JSON_UNESCAPED_UNICODE')) }}</pre>
                        {% if step.result %}
                            <details class="mt-2">
                                <summary class="cursor-pointer text-xs text-slate-600">Result</summary>
                                <pre class="mt-1 max-h-64 overflow-auto rounded bg-slate-50 p-2 text-xs">{{ step.result }}</pre>
                            </details>
                        {% endif %}
                    </li>
                {% endfor %}
            </ol>
        {% endif %}
    </section>

    {% if decisions is not empty %}
        <section class="mb-6">
            <h2 class="mb-2 text-lg font-semibold">Decisions</h2>
            {% if run.status.value == 'waiting' %}<p class="mb-2 text-sm text-amber-800">Paused until people decide in the <a class="underline" href="{{ path('app_inbox') }}">inbox</a>.</p>{% endif %}
            {{ include('decision/_list.html.twig') }}
        </section>
    {% endif %}

    {% if run.output %}
        <section class="mb-6">
            <h2 class="mb-2 text-lg font-semibold">Agent summary</h2>
            <div class="whitespace-pre-line rounded-lg border border-slate-200 bg-white p-4 text-sm">{{ run.output }}</div>
        </section>
    {% endif %}

    {% if run.error %}
        <div class="rounded-md bg-red-50 px-4 py-3 text-sm text-red-800">{{ run.error }}</div>
    {% endif %}
{% endblock %}
