<!DOCTYPE html>
<html lang="en" class="h-full bg-slate-50">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}Reflex{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚡</text></svg>">
        {% block stylesheets %}{% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>
    <body class="h-full text-slate-800 antialiased">
        <header class="border-b border-slate-200 bg-white">
            <nav class="mx-auto flex max-w-5xl items-center gap-8 px-4 py-3">
                <a href="{{ path('app_home') }}" class="text-lg font-semibold tracking-tight">⚡ Reflex</a>
                {% if app.user %}
                <a href="{{ path('app_inbox') }}" class="flex items-center gap-1.5 text-sm text-slate-600 hover:text-slate-900">
                    Inbox
                    {% set pending_count = pending_decisions() %}
                    {% if pending_count > 0 %}<span class="rounded-full bg-amber-500 px-1.5 text-xs font-semibold text-white">{{ pending_count }}</span>{% endif %}
                </a>
                <a href="{{ path('app_reflex_index') }}" class="text-sm text-slate-600 hover:text-slate-900">Reflexes</a>
                <a href="{{ path('app_connection_index') }}" class="text-sm text-slate-600 hover:text-slate-900">Connections</a>
                <form method="post" action="{{ logout_path() }}" class="ml-auto flex items-center gap-3 text-sm text-slate-500">
                    <span>{{ app.user.name }}{% if not is_granted('ROLE_ADMIN') %} · viewer{% endif %}</span>
                    <input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('logout') }}">
                    <button type="submit" class="text-slate-600 hover:text-slate-900">Sign out</button>
                </form>
                {% endif %}
            </nav>
        </header>

        <main class="mx-auto max-w-5xl px-4 py-8">
            {% for type, messages in app.flashes %}
                {% for message in messages %}
                    <div class="mb-4 rounded-md px-4 py-3 text-sm {{ type == 'error' ? 'bg-red-50 text-red-800' : 'bg-emerald-50 text-emerald-800' }}">{{ message }}</div>
                {% endfor %}
            {% endfor %}

            {% block body %}{% endblock %}
        </main>
    </body>
</html>
