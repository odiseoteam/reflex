<!DOCTYPE html>
<html lang="en" class="h-full bg-canvas">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}Reflex{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 20 20'%3E%3Cpath d='M16 1.5 7 10.25h6L4 19' fill='none' stroke='%232f5bea' stroke-width='3'/%3E%3C/svg%3E">
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap">
        {% block stylesheets %}{% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>
    <body class="h-full text-ink antialiased">
        {% set route = app.request.attributes.get('_route', '') %}
        {% set sections = [
            {label: 'Decisions', route: 'app_decision_index', prefixes: ['app_decision_']},
            {label: 'Runs', route: 'app_run_index', prefixes: ['app_run_']},
            {label: 'Reflexes', route: 'app_reflex_index', prefixes: ['app_reflex_']},
            {label: 'Connections', route: 'app_connection_index', prefixes: ['app_connection_']},
            {label: 'Apps', route: 'app_connected_apps', prefixes: ['app_connected_app']},
        ] %}
        <header class="border-b border-hairline bg-white">
            <nav class="mx-auto flex h-16 max-w-6xl items-center gap-5 px-6">
                <a href="{{ path('app_home') }}" class="flex items-center gap-5" title="Home"{% if route == 'app_home' %} aria-current="page"{% endif %}>
                    <span class="flex items-center gap-2 text-[17px] font-semibold tracking-tight">
                        <svg width="22" height="22" viewBox="0 0 20 20" aria-hidden="true" class="text-accent"><path d="M16 1.5 7 10.25h6L4 19" fill="none" stroke="currentColor" stroke-width="3" stroke-miterlimit="10"/></svg>
                        Reflex
                    </span>
                    {% if company_name is not empty %}
                        <span class="h-6 w-px bg-hairline" aria-hidden="true"></span>
                        <span class="flex items-center gap-2.5">
                            <span class="grid size-7 place-items-center rounded-md bg-[#0f2a4a] text-[11px] font-bold text-[#e8f1ff]" aria-hidden="true">
                                {{- company_name|split(' ')|slice(0, 2)|map(word => word|first|upper)|join -}}
                            </span>
                            <span class="text-sm font-semibold">{{ company_name }}</span>
                        </span>
                    {% endif %}
                </a>
                {% if app.user %}
                    <div class="ml-3 flex h-full items-stretch">
                        {% for section in sections %}
                            {% set active = section.prefixes|filter(prefix => route starts with prefix)|length > 0 %}
                            <a href="{{ path(section.route) }}"
                               {% if active %}aria-current="page"{% endif %}
                               class="flex items-center gap-1.5 border-b-2 px-3 text-sm {{ active ? 'border-ink font-semibold text-ink' : 'border-transparent text-slate-500 hover:text-ink' }}">
                                {{ section.label }}
                                {% if section.label == 'Decisions' %}
                                    {% set pending_count = pending_decisions() %}
                                    {% if pending_count > 0 %}<span class="rounded-full bg-amber-100 px-1.5 text-xs font-semibold text-amber-800">{{ pending_count }}</span>{% endif %}
                                {% endif %}
                            </a>
                        {% endfor %}
                    </div>
                    <form method="post" action="{{ logout_path() }}" class="ml-auto flex items-center gap-3 text-sm text-slate-500">
                        <span class="grid size-7 place-items-center rounded-full bg-[#dfe6f5] text-[11px] font-semibold text-[#23314f]" aria-hidden="true">
                            {{- app.user.name|split(' ')|filter(word => word matches '/^\\p{L}/u')|slice(0, 2)|map(word => word|first|upper)|join -}}
                        </span>
                        <span>{{ app.user.name }}{% if not is_granted('ROLE_ADMIN') %} · viewer{% endif %}</span>
                        <input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('logout') }}">
                        <button type="submit" title="Sign out" aria-label="Sign out" class="grid size-8 place-items-center rounded-md text-slate-500 hover:bg-slate-100 hover:text-ink">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 8V6a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h7a2 2 0 0 0 2-2v-2"/><path d="M9 12h12l-3-3m0 6 3-3"/></svg>
                        </button>
                    </form>
                {% endif %}
            </nav>
        </header>

        <main class="mx-auto max-w-6xl px-6 py-8">
            {% for type, messages in app.flashes %}
                {% for message in messages %}
                    <div class="mb-4 rounded-md px-4 py-3 text-sm {{ type == 'error' ? 'bg-red-50 text-red-800' : 'bg-emerald-50 text-emerald-800' }}">{{ message }}</div>
                {% endfor %}
            {% endfor %}

            {% block body %}{% endblock %}
        </main>
    </body>
</html>
